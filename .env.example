DJANGO_SECRET_KEY=replace-in-local-development
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ros_xolo
POSTGRES_USER=ros_xolo
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432
ROS_XOLO_TIME_ZONE=America/Mexico_City
EXPORT_STORAGE_ROOT=/app/private_exports
EXPORT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Contraseña local exclusiva para las cuentas generadas por `seed_demo`.
# Nunca se imprime ni se versiona el valor real.
ROS_XOLO_DEMO_PASSWORD=replace-with-a-local-demo-password
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# Solo para compose.production.yaml en XOLO-Core.
ROS_XOLO_HOSTNAME=planeacion.xolodev.com
ROS_XOLO_POSTGRES_PATH=/srv/apps/ros-xolo/postgres
ROS_XOLO_CONFIG_PATH=/srv/apps/ros-xolo/config
ROS_XOLO_EXPORT_PATH=/srv/apps/ros-xolo/private_exports
ROS_XOLO_STATIC_PATH=/srv/apps/ros-xolo/staticfiles
